---
import type { NavSection } from '../data/nav';

interface Props {
  section: NavSection;
}

const { section } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const count = section.pages.length;
---

<a class="card" href={`${base}/${section.pages[0].slug}/`}>
  <p class="card__label rubric">{section.label}</p>
  <p class="card__desc">{section.description}</p>
  <p class="card__count">{count} {count === 1 ? 'page' : 'pages'}</p>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border: 1px solid var(--fg-faint);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    background: var(--paper-bright);
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--dur-state) var(--ease-out),
      border-color var(--dur-state) var(--ease-out),
      transform var(--dur-state) var(--ease-out);
  }

  .card:hover {
    border-color: var(--navy);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
    color: inherit;
  }

  .card__label { color: var(--navy); }

  .card__desc {
    font-family: var(--font-body);
    font-size: var(--body-2);
    line-height: var(--lh-snug);
    color: var(--fg);
    flex: 1;
  }

  .card__count {
    font-family: var(--font-mono);
    font-size: var(--meta-2);
    color: var(--fg-lighter);
  }
</style>
