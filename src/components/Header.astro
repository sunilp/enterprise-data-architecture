---
import { SECTIONS } from '../data/nav';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__wordmark rubric" href={`${base}/`}>Enterprise Data Architecture</a>
    <nav class="site-header__nav" aria-label="Sections">
      {
        SECTIONS.map((s) => {
          const first = `${base}/${s.pages[0].slug}/`;
          const active = current.startsWith(`${base}/${s.pages[0].slug.split('/')[0]}/`);
          return (
            <a class:list={['site-header__link', { 'is-active': active }]} href={first}>
              {s.label}
            </a>
          );
        })
      }
      <button class="site-header__search" id="search-open" aria-label="Search">Search</button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--fg-faint);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .site-header__wordmark {
    color: var(--ink);
    white-space: nowrap;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .site-header__link {
    font-family: var(--font-mono);
    font-size: var(--meta-1);
    color: var(--fg-light);
  }

  .site-header__link:hover { color: var(--navy); }

  .site-header__link.is-active {
    color: var(--navy);
    border-bottom: 2px solid var(--navy);
    padding-bottom: 2px;
  }

  .site-header__search {
    font-family: var(--font-mono);
    font-size: var(--meta-1);
    color: var(--fg-light);
    background: transparent;
    border: 1px solid var(--fg-faint);
    border-radius: var(--radius-md);
    padding: var(--space-1) var(--space-3);
    transition: border-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out);
  }

  .site-header__search:hover {
    color: var(--navy);
    border-color: var(--navy);
  }

  @media (max-width: 900px) {
    .site-header__nav { display: none; }
    .site-header__inner::after {
      content: '';
    }
  }
</style>
